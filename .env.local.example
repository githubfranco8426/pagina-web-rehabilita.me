# URL de la app de reservas (App-Centro-Rehabilitame). Actualiza esto cuando
# esté desplegada (ej. https://reservas.rehabilita.me).
NEXT_PUBLIC_BOOKING_APP_URL=http://localhost:3001

# Google Analytics 4 — Measurement ID de tu propiedad GA4 (formato G-XXXXXXX).
# Se obtiene en analytics.google.com > Administrar > Flujos de datos > Web.
# Mientras esta variable esté vacía, el sitio no carga ningún tag de Google.
NEXT_PUBLIC_GA_ID=

# Google Ads — ID de conversión (formato AW-XXXXXXX), se obtiene en
# ads.google.com > Herramientas > Conversiones > [tu acción] > Configuración.
# Opcional: solo hace falta cuando quieras medir conversiones de campañas de Ads.
NEXT_PUBLIC_GOOGLE_ADS_ID=
